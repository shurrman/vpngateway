[Unit]
Description=VPN Gateway Admin API
After=network-online.target vpngw-routing.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vpngateway/api
ExecStart=/opt/vpngateway/api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 443 --ssl-keyfile=/opt/vpngateway/certs/server.key --ssl-certfile=/opt/vpngateway/certs/server.crt
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
