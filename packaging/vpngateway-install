#!/bin/bash
# Explicit entrypoint installed by the DEB/RPM payload packages.

set -euo pipefail

SOURCE_DIR=/usr/lib/vpngateway
CONFIG_DIR=/etc/vpngateway
CONFIG_FILE="$CONFIG_DIR/vpngateway.conf"
CONFIG_EXAMPLE="$CONFIG_DIR/vpngateway.conf.example"

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: run vpngateway-install as root" >&2
    exit 1
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
    install -d -m 0755 "$CONFIG_DIR"
    install -m 0600 "$CONFIG_EXAMPLE" "$CONFIG_FILE"
    echo "Created $CONFIG_FILE"
    echo "Edit it for this gateway, then run: sudo vpngateway-install"
    exit 2
fi

exec env VPNGATEWAY_CONF_FILE="$CONFIG_FILE" "$SOURCE_DIR/install.sh" "$@"
